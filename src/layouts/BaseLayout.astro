---
import siteConfig from "../../config/site.config.ts";
import SiteFooter from "../components/navigation/SiteFooter.astro";
import CookieConsent from "../components/consent/CookieConsent.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, canonical, image, noindex = false } = Astro.props;
const pageDescription = description ?? siteConfig.site.description;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteConfig.site.origin).href;
const ogImage = image ? new URL(image, siteConfig.site.origin).href : undefined;
---

<!doctype html>
<html lang={siteConfig.site.defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteConfig.site.name}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
    <style is:global>
      :root {
        --color-bg: #fafafa;
        --color-surface: #ffffff;
        --color-text: #1a1a1a;
        --color-muted: #666;
        --color-accent: #2563eb;
        --color-border: #e5e5e5;
        --color-closed: #b91c1c;
        --font-sans: system-ui, -apple-system, sans-serif;
        --max-width: 72rem;
        --radius: 0.5rem;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }
      a { color: var(--color-accent); }
      .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem; }
      main { padding: 2rem 0 4rem; }
      h1 { font-size: 2rem; margin-bottom: 0.5rem; }
      h2 { font-size: 1.25rem; margin: 1.5rem 0 0.75rem; }
      .muted { color: var(--color-muted); }
      .card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.25rem;
      }
      .grid { display: grid; gap: 1rem; }
      @media (min-width: 640px) { .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (min-width: 1024px) { .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      .badge {
        display: inline-block;
        font-size: 0.75rem;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background: #fee2e2;
        color: var(--color-closed);
        font-weight: 600;
      }

      dl.contact dt { font-weight: 600; margin-top: 0.5rem; }
      dl.contact dd { margin-left: 0; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--color-border); }
      .breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
        font-size: 0.875rem;
        color: var(--color-muted);
        margin-bottom: 1rem;
      }
      .breadcrumb-item { display: inline-flex; align-items: center; gap: 0.25rem; }
      .breadcrumb-sep { color: var(--color-border); user-select: none; }
      .tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
      .tag {
        display: inline-block;
        font-size: 0.8125rem;
        padding: 0.25rem 0.625rem;
        border-radius: 999px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        text-decoration: none;
        color: var(--color-text);
      }
      .tag:hover { border-color: var(--color-accent); color: var(--color-accent); }
      .cta-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 1.25rem 0;
      }
      .cta {
        display: inline-block;
        padding: 0.625rem 1.25rem;
        border-radius: var(--radius);
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9375rem;
        color: var(--color-text);
      }
      .cta:hover { border-color: var(--color-accent); color: var(--color-accent); }
      .cta-primary {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: #fff;
      }
      .cta-primary:hover { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    </style>
  </head>
  <body>
    <slot name="header" />
    <main class="container">
      <slot />
    </main>
    <SiteFooter />
    <CookieConsent />
  </body>
</html>
