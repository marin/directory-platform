---
import { Font } from "astro:assets";
import siteConfig from "../../config/site.config.ts";
import SiteFooter from "../components/navigation/SiteFooter.astro";
import CookieConsent from "../components/consent/CookieConsent.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
}

const { title, description, canonical, image, noindex = false, ogType = "website" } = Astro.props;
const pageTitle = `${title} | ${siteConfig.site.name}`;
const pageDescription = description ?? siteConfig.site.description;
// canonical/og:url always carry a trailing slash to match the sitemap's <loc> values.
const trailingSlashPathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ?? new URL(trailingSlashPathname, siteConfig.site.origin).href;
const ogImage = image
  ? new URL(image, siteConfig.site.origin).href
  : new URL("/og-default.png", siteConfig.site.origin).href;
const ogLocale = siteConfig.site.defaultLocale.replace("-", "_");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.site.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    {
      !image && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={`${siteConfig.site.name} – Verzeichnis für Heilpraktiker in Berlin`} />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <slot name="head" />
    <style is:global>
      :root {
        --color-bg: #f0efeb;
        --color-surface: #ffffff;
        --color-text: #241a54;
        --color-body: #332a63;
        --color-muted: #5b5185;
        --color-accent: #c2300a;
        --color-accent-hover: #a52708;
        --color-accent-active: #8c2006;
        --color-signal: #f8e11f;
        --color-soft: #f4a9bf;
        --color-blue: #1f5fae;
        --color-green: #1c6b45;
        --color-lilac: #8d84c2;
        --color-border: #cfcbe6;
        --color-border-dark: #6259a3;
        --color-visited: #7a3f8f;
        --color-closed: #c2300a;
        --max-width: 84rem;
        --gutter: 3rem;
        --radius: 1.25rem;
        --radius-tile: 1.125rem;
        --radius-panel: 1.5rem;
        --radius-pill: 999px;
        --border-card: 2px solid var(--color-text);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: var(--font-display);
        letter-spacing: -0.025em;
        line-height: 1.05;
        text-wrap: balance;
      }
      h1 { font-size: clamp(2.375rem, 4.4vw, 3.875rem); font-weight: 800; }
      h2 { font-size: clamp(1.5rem, 2.2vw, 2.125rem); font-weight: 700; margin: 0 0 1rem; }
      h3 { font-size: 1.25rem; font-weight: 600; line-height: 1.15; }
      p { text-wrap: pretty; }
      a { color: var(--color-accent); }
      a:visited { color: var(--color-visited); }
      a:hover { color: var(--color-accent-hover); }
      a:focus-visible { outline: 3px solid var(--color-text); outline-offset: 3px; }
      .container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
      main { padding: 1.5rem 0 4rem; display: flex; flex-direction: column; gap: 3rem; }
      .muted { color: var(--color-muted); }
      .mono {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        letter-spacing: 0.02em;
      }
      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .card {
        background: var(--color-surface);
        border: var(--border-card);
        border-radius: var(--radius);
        padding: 1.25rem;
      }
      .grid { display: grid; gap: 1rem; }
      @media (min-width: 640px) {
        .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (min-width: 1024px) {
        .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }

      /* Bänder */
      .band {
        background: var(--color-text);
        color: var(--color-bg);
        border-radius: var(--radius-panel);
        padding: 2rem;
      }
      .band h2 { color: var(--color-bg); }

      /* Chips */
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        min-height: 40px;
        padding: 0.5rem 1rem;
        border: 2px solid var(--color-text);
        border-radius: var(--radius-pill);
        background: transparent;
        color: var(--color-text);
        font-size: 0.90625rem;
        font-weight: 500;
        text-decoration: none;
        line-height: 1.2;
      }
      a.chip:hover { background: var(--color-signal); color: var(--color-text); }
      .chip--active,
      .chip[aria-current="page"] {
        background: var(--color-text);
        color: var(--color-bg);
      }
      .chip--method { background: var(--color-signal); }
      .chip--assoc { background: var(--color-soft); }
      .chip--outline { background: transparent; }
      .chip--closed {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: #fff;
      }
      .chip--ghost {
        border-style: dashed;
        border-color: var(--color-border-dark);
        color: var(--color-muted);
      }
      .chip--sm { min-height: 30px; padding: 0.1875rem 0.625rem; font-size: 0.8125rem; border-width: 2px; }
      .tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
      .tag {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 0.1875rem 0.625rem;
        font-size: 0.8125rem;
        border: 2px solid var(--color-text);
        border-radius: var(--radius-pill);
        background: var(--color-surface);
        text-decoration: none;
        color: var(--color-text);
      }
      a.tag:hover { background: var(--color-signal); }
      .tag-static { cursor: default; }
      .tag-badge { background: var(--color-signal); font-weight: 600; }
      .badge {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 0.125rem 0.625rem;
        border-radius: var(--radius-pill);
        background: var(--color-accent);
        color: #fff;
        font-weight: 600;
      }

      /* Aktionen */
      .cta-bar { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.25rem 0; }
      .cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.625rem 1.375rem;
        border-radius: var(--radius-pill);
        border: 2px solid var(--color-text);
        background: var(--color-surface);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9375rem;
        color: var(--color-text);
      }
      .cta:hover { background: var(--color-signal); color: var(--color-text); }
      .cta-primary {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: #fff;
      }
      .cta-primary:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); color: #fff; }
      .cta-ghost { background: transparent; }

      /* Text-Bausteine */
      dl.contact dt {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-muted);
        margin-top: 0.75rem;
      }
      dl.contact dd { margin-left: 0; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: 0.5rem; border-bottom: 2px dashed var(--color-border); }
      .breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-muted);
        margin-bottom: 1rem;
      }
      .breadcrumb-item { display: inline-flex; align-items: center; gap: 0.25rem; }
      .breadcrumb-sep { color: var(--color-border-dark); user-select: none; }

      @media (max-width: 640px) {
        :root { --gutter: 1.25rem; }
        main { gap: 2rem; }
        .band { padding: 1.5rem 1.25rem; }
      }
    </style>
  </head>
  <body>
    <slot name="header" />
    <main class="container">
      <slot />
    </main>
    <SiteFooter />
    <CookieConsent />
  </body>
</html>
