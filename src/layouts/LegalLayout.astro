---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/navigation/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const legalLinks = [
  { href: "/ueber-uns/", label: "Über uns" },
  { href: "/kontakt/", label: "Kontakt" },
  { href: "/eintrag-melden/", label: "Eintrag melden" },
  { href: "/impressum/", label: "Impressum" },
  { href: "/datenschutz/", label: "Datenschutz" },
  { href: "/nutzungsbedingungen/", label: "Nutzungsbedingungen" },
];
// Both sides are normalized without a trailing slash so the active-page
// comparison keeps working now that `legalLinks` hrefs end in "/".
const current = Astro.url.pathname.replace(/\/$/, "");
const stand = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric",
}).format(new Date());
---

<BaseLayout title={title} description={description}>
  <SiteHeader slot="header" />
  <div class="legal">
    <nav class="legal__nav" aria-label="Rechtliches">
      <p class="legal__navhead">Seiten</p>
      <ul>
        {legalLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href.replace(/\/$/, "") ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <article class="legal-page">
      <h1>{title}</h1>
      <div class="legal-page__content">
        <slot />
      </div>
      <p class="legal-page__meta">Stand: {stand}</p>
    </article>
  </div>
</BaseLayout>

<style>
  .legal {
    display: grid;
    grid-template-columns: minmax(200px, 260px) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .legal__nav {
    position: sticky;
    top: 1.5rem;
    background: var(--color-surface);
    border: var(--border-card);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .legal__navhead {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }
  .legal__nav ul { list-style: none; display: flex; flex-direction: column; gap: 0.125rem; }
  .legal__nav a {
    display: block;
    padding: 0.5rem 0.625rem;
    border-radius: 10px;
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .legal__nav a:visited { color: var(--color-text); }
  .legal__nav a:hover { background: var(--color-signal); }
  .legal__nav a[aria-current="page"] {
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
  }

  .legal-page { max-width: 68ch; }
  .legal-page h1 { margin-bottom: 1.5rem; }
  .legal-page__content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    margin: 2.25rem 0 0.75rem;
  }
  .legal-page__content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    margin: 1.5rem 0 0.5rem;
  }
  .legal-page__content :global(p),
  .legal-page__content :global(ul),
  .legal-page__content :global(ol) {
    margin-bottom: 0.875rem;
    color: var(--color-body);
  }
  .legal-page__content :global(ul),
  .legal-page__content :global(ol) { padding-left: 1.5rem; }
  .legal-page__content :global(li) { margin-bottom: 0.35rem; }
  .legal-page__meta {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 2px dashed var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .legal { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .legal__nav { position: static; }
    .legal__nav ul { flex-direction: row; flex-wrap: wrap; }
  }
</style>
