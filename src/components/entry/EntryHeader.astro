---
import type { EntryViewModel } from "../../lib/data/view-models/entry.ts";
import { categoryPath, areaPath } from "../../lib/routing/paths.ts";

interface Props {
  vm: EntryViewModel;
}
const { vm } = Astro.props;
const { entry } = vm;
const hasTags = vm.categories.length > 0 || vm.areas.length > 0;
const hasIndications = vm.indications.length > 0;
---

<header>
  <h1 data-testid="entry-name">{entry.nap.name}</h1>
  {!entry.isOpen && <p class="badge" data-testid="closed-notice">Dauerhaft geschlossen</p>}
  {
    hasTags && (
      <p class="tag-list" data-testid="entry-tags">
        {vm.categories.map((category) => (
          <a href={categoryPath(category.slug)} class="tag" data-testid="entry-category-link">
            {category.name}
          </a>
        ))}
        {vm.areas.map((area) => (
          <a href={areaPath(area.slug)} class="tag" data-testid="entry-area-link">
            {area.name}
          </a>
        ))}
      </p>
    )
  }
  {
    hasIndications && (
      <p class="tag-list" data-testid="entry-indications">
        <span class="muted">Behandelt unter anderem</span>
        {vm.indications.map((indication) => (
          <span class="tag tag-static" data-testid="entry-indication">
            {indication.name}
          </span>
        ))}
      </p>
    )
  }
  <p class="muted" style="margin-top: 0.5rem;">{vm.contextFact}</p>
</header>
