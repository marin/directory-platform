---
import type { EntryViewModel } from "../../lib/data/view-models/entry.ts";
import { categoryPath, areaPath, indicationPath } from "../../lib/routing/paths.ts";

interface Props {
  vm: EntryViewModel;
}
const { vm } = Astro.props;
const { entry } = vm;
const hasTags = vm.categories.length > 0 || vm.areas.length > 0;
const hasIndications = vm.indications.length > 0;
const hasAssociations = vm.associations.length > 0;
const hasBadges = vm.badges.length > 0;
---

<header>
  <h1 data-testid="entry-name">{entry.nap.name}</h1>
  {!entry.isOpen && <p class="badge" data-testid="closed-notice">Dauerhaft geschlossen</p>}
  {
    hasBadges && (
      <p class="tag-list" data-testid="entry-badges">
        {vm.badges.map((badge) =>
          badge.href ? (
            <a href={badge.href} class="tag tag-badge" data-testid={`entry-badge-${badge.id}`}>
              {badge.label}
            </a>
          ) : (
            <span class="tag tag-static tag-badge" data-testid={`entry-badge-${badge.id}`}>
              {badge.label}
            </span>
          ),
        )}
      </p>
    )
  }
  {
    hasTags && (
      <p class="tag-list" data-testid="entry-tags">
        {vm.categories.map((category) => (
          <a href={categoryPath(category.slug)} class="tag" data-testid="entry-category-link">
            {category.name}
          </a>
        ))}
        {vm.areas.map((area) => (
          <a href={areaPath(area.slug)} class="tag" data-testid="entry-area-link">
            {area.name}
          </a>
        ))}
      </p>
    )
  }
  {
    hasAssociations && (
      <p class="tag-list" data-testid="entry-associations">
        {vm.associations.map((association) => (
          <span class="tag tag-static" data-testid={`entry-association-${association.id}`}>
            {association.label}
          </span>
        ))}
      </p>
    )
  }
  {
    hasIndications && (
      <p class="tag-list" data-testid="entry-indications">
        <span class="muted">Behandelt unter anderem</span>
        {vm.indications.map((indication) => (
          <a href={indicationPath(indication.slug)} class="tag" data-testid="entry-indication-link">
            {indication.name}
          </a>
        ))}
      </p>
    )
  }
  <p class="muted" style="margin-top: 0.5rem;">{vm.contextFact}</p>
</header>
