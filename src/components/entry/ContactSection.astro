---
import type { NormalizedEntry } from "../../lib/data/normalize-entry.ts";
import { instagramHandleFromUrl } from "../../lib/data/extract-instagram.ts";
import {
  formatGoogleMapsRating,
  formatGoogleMapsRatingsCount,
  hasGoogleMapsRating,
} from "../../lib/geo/google-maps-rating.ts";
import siteConfig from "../../../config/site.config.ts";

interface Props {
  entry: NormalizedEntry;
}
const { entry } = Astro.props;
const nap = entry.nap;
const mapsUrl = entry.googleMapsUrl;
const showGoogleRating = hasGoogleMapsRating(entry);
const locale = siteConfig.site.defaultLocale;
const instagramHandle = entry.instagramUrl
  ? instagramHandleFromUrl(entry.instagramUrl)
  : undefined;
---

<section aria-labelledby="contact-heading">
  <h2 id="contact-heading">Kontakt</h2>
  <dl class="contact" data-testid="nap-block">
    <dt>Name</dt>
    <dd data-testid="nap-name">{nap.name}</dd>
    {
      showGoogleRating && (
        <>
          <dt>Google Bewertung</dt>
          <dd data-testid="nap-google-rating">
            ★ {formatGoogleMapsRating(entry.googleMapsRating!, locale)} ·{" "}
            {formatGoogleMapsRatingsCount(entry.googleMapsRatingsCount!, locale)} Bewertungen
            {mapsUrl && (
              <>
                {" "}
                (<a href={mapsUrl} target="_blank" rel="noopener noreferrer" translate="no">
                  Google Maps
                </a>)
              </>
            )}
          </dd>
        </>
      )
    }
    {nap.formattedPhone && (
      <>
        <dt>Telefon</dt>
        <dd data-testid="nap-phone"><a href={`tel:${nap.phone}`}>{nap.formattedPhone}</a></dd>
      </>
    )}
    {nap.formattedAddress && (
      <>
        <dt>Adresse</dt>
        <dd data-testid="nap-address">
          {nap.formattedAddress}
          {mapsUrl && (
            <>
              {" "}
              (<a href={mapsUrl} target="_blank" rel="noopener noreferrer">in Google Maps öffnen</a>)
            </>
          )}
        </dd>
      </>
    )}
    {entry.email && (
      <>
        <dt>E-Mail</dt>
        <dd><a href={`mailto:${entry.email}`}>{entry.email}</a></dd>
      </>
    )}
    {entry.website && (
      <>
        <dt>Website</dt>
        <dd><a href={entry.website} rel="noopener noreferrer">{entry.website}</a></dd>
      </>
    )}
    {entry.instagramUrl && instagramHandle && (
      <>
        <dt>Instagram</dt>
        <dd>
          <a
            href={entry.instagramUrl}
            rel="noopener noreferrer"
            translate="no"
            data-testid="nap-instagram"
          >
            {instagramHandle}
          </a>
        </dd>
      </>
    )}
  </dl>
</section>
