---
import type { EntryViewModel } from "../../lib/data/view-models/entry.ts";
import EntryGoogleRatingSection from "./EntryGoogleRatingSection.astro";
import EntryCtaBar from "./EntryCtaBar.astro";
import ContactSection from "./ContactSection.astro";
import OpeningHoursSection from "./OpeningHoursSection.astro";
import EntryClaimLink from "./EntryClaimLink.astro";

interface Props {
  vm: EntryViewModel;
}

const { vm } = Astro.props;
const { entry } = vm;
const phone = entry.nap.phone;
const primaryAction = entry.bookingUrl ?? entry.website;
---

<aside class="sidebar" data-testid="entry-sidebar">
  <div class="sidebar__inner">
    <div class="sidebar__panel sidebar__panel--rating">
      <EntryGoogleRatingSection entry={entry} />
    </div>

    <div class="sidebar__panel sidebar__panel--cta">
      <EntryCtaBar entry={entry} />
    </div>

    <div class="sidebar__panel">
      <ContactSection entry={entry} />
    </div>

    <div class="sidebar__panel sidebar__panel--hours">
      <OpeningHoursSection entry={entry} />
    </div>

    <div class="sidebar__panel sidebar__panel--claim">
      <p class="sidebar__claimtitle">Ist das Ihre Praxis?</p>
      <p class="sidebar__claimtext">
        Foto, Leistungen und Zeiten ergänzen — kostenlos, ohne Konto.
        Wir prüfen die Angaben und nennen Sie als Quelle.
      </p>
      <EntryClaimLink slug={entry.slug} />
    </div>
  </div>
</aside>

{entry.isOpen && (primaryAction || phone) && (
  <div class="mobilebar" data-testid="entry-mobilebar">
    {primaryAction && (
      <a class="cta cta-primary" href={primaryAction} rel="noopener noreferrer">Termin anfragen</a>
    )}
    {phone && <a class="cta" href={`tel:${phone}`}>Anrufen</a>}
  </div>
)}

<style>
  .sidebar { min-width: 0; }
  .sidebar__inner {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar__panel {
    background: var(--color-surface);
    border: var(--border-card);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .sidebar__panel:empty { display: none; }
  .sidebar__panel :global(h2) {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }
  .sidebar__panel :global(section:empty) { display: none; }
  .sidebar__panel--rating :global(.gmp-rating--profile) {
    border: 0;
    padding: 0;
    background: transparent;
  }
  .sidebar__panel--cta :global(.cta-bar) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
  }
  .sidebar__panel--cta :global(.cta) { width: 100%; }
  .sidebar__panel--hours { background: var(--color-signal); }
  .sidebar__panel--hours :global(th),
  .sidebar__panel--hours :global(td) {
    border-bottom-color: rgb(36 26 84 / 0.25);
    padding: 0.375rem 0;
    font-size: 0.9375rem;
  }
  .sidebar__panel--claim {
    border-style: dashed;
    background: var(--color-surface);
  }
  .sidebar__claimtitle {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .sidebar__claimtext {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-body);
  }
  .sidebar__panel--claim :global(.entry-claim) { margin: 0.75rem 0 0; }

  .mobilebar { display: none; }

  @media (max-width: 1023px) {
    .sidebar__inner { position: static; }
    .mobilebar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      display: flex;
      gap: 0.75rem;
      padding: 0.75rem var(--gutter);
      background: var(--color-text);
    }
    .mobilebar .cta { flex: 1; }
  }
</style>
