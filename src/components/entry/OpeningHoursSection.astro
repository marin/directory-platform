---
import type { NormalizedEntry } from "../../lib/data/normalize-entry.ts";
import { groupOpeningHoursByDay } from "../../lib/data/parse-opening-hours.ts";

interface Props {
  entry: NormalizedEntry;
}
const { entry } = Astro.props;
const groupedHours = groupOpeningHoursByDay(entry.openingHours ?? []);

const dayNames: Record<string, string> = {
  Monday: "Montag",
  Tuesday: "Dienstag",
  Wednesday: "Mittwoch",
  Thursday: "Donnerstag",
  Friday: "Freitag",
  Saturday: "Samstag",
  Sunday: "Sonntag",
};
---

{entry.isOpen && groupedHours.length > 0 && (
  <section aria-labelledby="hours-heading">
    <h2 id="hours-heading">Öffnungszeiten</h2>
    <table>
      <thead><tr><th>Tag</th><th>Uhrzeiten</th></tr></thead>
      <tbody>
        {groupedHours.map((dayHours) => (
          <tr>
            <td>{dayNames[dayHours.day] ?? dayHours.day}</td>
            <td>
              {dayHours.ranges
                .map((range) => `${range.open} – ${range.close}`)
                .join(", ")}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
)}
