---
import type { NormalizedEntry } from "../../lib/data/normalize-entry.ts";

interface Props {
  entry: NormalizedEntry;
}
const { entry } = Astro.props;
const hours = entry.openingHours ?? [];

const dayNames: Record<string, string> = {
  Monday: "Montag",
  Tuesday: "Dienstag",
  Wednesday: "Mittwoch",
  Thursday: "Donnerstag",
  Friday: "Freitag",
  Saturday: "Samstag",
  Sunday: "Sonntag",
};
---

{entry.isOpen && hours.length > 0 && (
  <section aria-labelledby="hours-heading">
    <h2 id="hours-heading">Öffnungszeiten</h2>
    <table>
      <thead><tr><th>Tag</th><th>Uhrzeiten</th></tr></thead>
      <tbody>
        {hours.map((h) => (
          <tr><td>{dayNames[h.day] ?? h.day}</td><td>{h.open} – {h.close}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
)}
