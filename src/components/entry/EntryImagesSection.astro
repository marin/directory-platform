---
import type { EntryViewModel } from "../../lib/data/view-models/entry.ts";
import { buildImageAlt } from "../../lib/media/entry-images.ts";

interface Props {
  vm: EntryViewModel;
}

const { vm } = Astro.props;
const { entry, images } = vm;
const [heroImage, ...galleryImages] = images;
---

{
  heroImage && (
    <section aria-labelledby="images-heading" data-testid="entry-images-section">
      <h2 id="images-heading" class="visually-hidden">Praxisfotos</h2>
      <div class="hero-image">
        <img
          src={heroImage}
          alt={buildImageAlt(entry.name)}
          width="1200"
          height="675"
          loading="eager"
          decoding="async"
          data-testid="entry-hero-image"
        />
      </div>
      {
        galleryImages.length > 0 && (
          <div class="gallery" data-testid="entry-gallery">
            {galleryImages.map((image, index) => (
              <img
                src={image}
                alt={buildImageAlt(entry.name, index + 1)}
                width="400"
                height="300"
                loading="lazy"
                decoding="async"
                data-testid="entry-gallery-image"
              />
            ))}
          </div>
        )
      }
    </section>
  )
}

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .hero-image {
    margin: 1rem 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
</style>
