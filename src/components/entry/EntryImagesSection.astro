---
import type { EntryViewModel } from "../../lib/data/view-models/entry.ts";
import { buildImageAlt } from "../../lib/media/entry-images.ts";
import ImagePlaceholder from "../media/ImagePlaceholder.astro";

interface Props {
  vm: EntryViewModel;
}

const { vm } = Astro.props;
const { entry, images } = vm;
const [heroImage, second, third] = images;
const seed = vm.category?.slug ?? entry.slug;
---

<section class="strip" aria-labelledby="images-heading" data-testid="entry-images-section">
  <h2 id="images-heading" class="visually-hidden">Praxisfotos</h2>

  <div class="strip__main">
    {heroImage ? (
      <img
        src={heroImage}
        alt={buildImageAlt(entry.name)}
        width="1200"
        height="675"
        loading="eager"
        decoding="async"
        data-testid="entry-hero-image"
      />
    ) : (
      <ImagePlaceholder height={168} seed={seed} label="Kein Foto hinterlegt" />
    )}
  </div>

  <div class="strip__side">
    {second ? (
      <img
        src={second}
        alt={buildImageAlt(entry.name, 1)}
        width="400"
        height="300"
        loading="lazy"
        decoding="async"
        data-testid="entry-gallery-image"
      />
    ) : (
      <ImagePlaceholder height={168} seed={`${seed}-2`} />
    )}
  </div>

  <div class="strip__side">
    {third ? (
      <img
        src={third}
        alt={buildImageAlt(entry.name, 2)}
        width="400"
        height="300"
        loading="lazy"
        decoding="async"
        data-testid="entry-gallery-image"
      />
    ) : (
      <ImagePlaceholder height={168} seed={`${seed}-3`} />
    )}
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .strip {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 1rem;
  }
  .strip img {
    display: block;
    width: 100%;
    height: 168px;
    object-fit: cover;
    border-radius: 20px;
    border: 2px solid var(--color-text);
    background: var(--color-surface);
  }
  .strip__main img { height: 168px; }

  @media (min-width: 1024px) {
    .strip img,
    .strip__main img { height: 240px; }
  }
  @media (max-width: 640px) {
    .strip { grid-template-columns: 1fr 1fr; }
    .strip__main { grid-column: 1 / -1; }
  }
</style>
