---
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const hasAnalytics = Boolean(gaId);
---

{hasAnalytics && (
  <div id="cookie-banner" class="cookie-banner" role="dialog" aria-labelledby="cookie-banner-title" aria-live="polite" hidden>
    <div class="cookie-banner__inner">
      <p id="cookie-banner-title">
        <strong>Cookies &amp; Analyse</strong><br />
        Wir verwenden Google Analytics, um die Nutzung dieser Website anonym auszuwerten.
        Details finden Sie in unserer <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
      <div class="cookie-banner__actions">
        <button type="button" class="cookie-banner__btn cookie-banner__btn--accept" data-consent="accept">
          Akzeptieren
        </button>
        <button type="button" class="cookie-banner__btn cookie-banner__btn--decline" data-consent="decline">
          Ablehnen
        </button>
      </div>
    </div>
  </div>
)}

{hasAnalytics && (
  <script define:vars={{ gaId }}>
    const CONSENT_KEY = "ga-consent";
    const banner = document.getElementById("cookie-banner");

    function loadGa() {
      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", gaId, { anonymize_ip: true });
    }

    function hideBanner() {
      if (banner) banner.hidden = true;
    }

    function showBanner() {
      if (banner) banner.hidden = false;
    }

    const stored = localStorage.getItem(CONSENT_KEY);
    if (stored === "granted") {
      loadGa();
      hideBanner();
    } else if (stored === "denied") {
      hideBanner();
    } else {
      showBanner();
    }

    banner?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const choice = target.dataset.consent;
      if (choice === "accept") {
        localStorage.setItem(CONSENT_KEY, "granted");
        loadGa();
        hideBanner();
      } else if (choice === "decline") {
        localStorage.setItem(CONSENT_KEY, "denied");
        hideBanner();
      }
    });
  </script>
)}

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.08);
    padding: 1rem;
  }
  .cookie-banner__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cookie-banner__inner p {
    margin: 0;
    max-width: 42rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .cookie-banner__actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .cookie-banner__btn {
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .cookie-banner__btn--accept {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .cookie-banner__btn--accept:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
  }
  .cookie-banner__btn--decline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
