---
import siteConfig from "../../../config/site.config.ts";

interface Props {
  subject?: string;
  showSubject?: boolean;
}

const { subject = "", showSubject = true } = Astro.props;
---

<form
  class="contact-form"
  action={siteConfig.forms.contactAction}
  method="POST"
  data-testid="contact-form"
>
  {showSubject && (
    <label class="contact-form__field">
      <span>Betreff</span>
      <select name="subject" required>
        <option value="" disabled selected={!subject}>Bitte wählen …</option>
        <option value="Allgemeine Anfrage" selected={subject === "Allgemeine Anfrage"}>Allgemeine Anfrage</option>
        <option value="Eintrag korrigieren" selected={subject === "Eintrag korrigieren"}>Eintrag korrigieren</option>
        <option value="Eintrag beanspruchen" selected={subject === "Eintrag beanspruchen"}>Eintrag beanspruchen</option>
        <option value="Neuen Eintrag vorschlagen" selected={subject === "Neuen Eintrag vorschlagen"}>Neuen Eintrag vorschlagen</option>
        <option value="Eintrag löschen" selected={subject === "Eintrag löschen"}>Eintrag löschen</option>
        <option value="Datenschutzanfrage" selected={subject === "Datenschutzanfrage"}>Datenschutzanfrage</option>
      </select>
    </label>
  )}
  {!showSubject && subject && <input type="hidden" name="subject" value={subject} />}
  <input type="hidden" name="listing_url" id="listing-url" />

  <label class="contact-form__field">
    <span>Praxisname oder Ihr Name</span>
    <input type="text" name="name" required autocomplete="name" />
  </label>

  <label class="contact-form__field">
    <span>E-Mail</span>
    <input type="email" name="email" required autocomplete="email" />
  </label>

  <label class="contact-form__field">
    <span>Website oder Telefon</span>
    <input type="text" name="contact" autocomplete="url" />
  </label>

  <fieldset class="contact-form__field contact-form__roles">
    <legend><span>Ihre Rolle</span></legend>
    <div class="contact-form__radios">
      <label><input type="radio" name="role" value="Praxis selbst" checked /> Praxis selbst</label>
      <label><input type="radio" name="role" value="Patient" /> Patient</label>
      <label><input type="radio" name="role" value="Sonstiges" /> Sonstiges</label>
    </div>
  </fieldset>

  <label class="contact-form__field">
    <span>Anmerkung</span>
    <textarea name="message" rows="6" required></textarea>
  </label>

  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="_subject" value={`[${siteConfig.site.name}] Kontaktanfrage`} />

  <p class="contact-form__hint">
    Wir melden uns nur, wenn etwas unklar ist. Keine Newsletter, keine Weitergabe.
    Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Angaben gemäß unserer
    <a href="/datenschutz">Datenschutzerklärung</a> zu. Alternativ erreichen Sie uns unter
    <a href={`mailto:${siteConfig.operator.email}`}>{siteConfig.operator.email}</a>.
  </p>

  <button type="submit" class="contact-form__submit">Eintrag vorschlagen</button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.125rem;
    max-width: 36rem;
    margin-top: 1.5rem;
  }
  .contact-form__field {
    display: grid;
    gap: 0.375rem;
    font-size: 0.9375rem;
    border: 0;
    padding: 0;
  }
  .contact-form__field span,
  .contact-form__field legend span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .contact-form__field input[type="text"],
  .contact-form__field input[type="email"],
  .contact-form__field select,
  .contact-form__field textarea {
    padding: 0.75rem 0.875rem;
    border: 2px solid var(--color-text);
    border-radius: 14px;
    font: inherit;
    background: var(--color-surface);
    color: var(--color-text);
  }
  .contact-form__field input:focus-visible,
  .contact-form__field select:focus-visible,
  .contact-form__field textarea:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .contact-form__radios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 0.375rem;
  }
  .contact-form__radios label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
  }
  .contact-form__hint {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
    max-width: 46ch;
  }
  .contact-form__submit {
    justify-self: start;
    min-height: 44px;
    padding: 0.625rem 1.5rem;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .contact-form__submit:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); }
</style>
