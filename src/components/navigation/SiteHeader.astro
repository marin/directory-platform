---
import siteConfig from "../../../config/site.config.ts";
import { categoryPath, indicationsPath } from "../../lib/routing/paths.ts";

interface Props {
  categories?: Array<{ id: string; name: string; slug: string; count: number }>;
}
const { categories = [] } = Astro.props;
---

<header style="border-bottom: 1px solid var(--color-border); padding: 1rem 0; margin-bottom: 1rem;">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <a href="/" style="font-weight: 700; font-size: 1.125rem; text-decoration: none; color: inherit;">
      {siteConfig.site.name}
    </a>
    <nav aria-label="Hauptnavigation">
      <ul style="display: flex; gap: 1rem; list-style: none; flex-wrap: wrap;">
        {categories.slice(0, 5).map((cat) => (
          <li><a href={categoryPath(cat.slug)}>{cat.name} ({cat.count})</a></li>
        ))}
        <li><a href={indicationsPath()}>Beschwerden</a></li>
      </ul>
    </nav>
  </div>
</header>
