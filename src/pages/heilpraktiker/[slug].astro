---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/navigation/SiteHeader.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import EntryHeader from "../../components/entry/EntryHeader.astro";
import EntrySidebar from "../../components/entry/EntrySidebar.astro";
import OffersSection from "../../components/entry/OffersSection.astro";
import EntryMapSection from "../../components/entry/EntryMapSection.astro";
import EntryImagesSection from "../../components/entry/EntryImagesSection.astro";
import siteConfig from "../../../config/site.config.ts";
import LastUpdated from "../../components/entry/LastUpdated.astro";
import RelatedEntries from "../../components/entry/RelatedEntries.astro";
import FaqSection from "../../components/faq/FaqSection.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import { loadDataset } from "../../lib/data/load-dataset.ts";
import {
  toEntryViewModel,
  toEntryCardViewModel,
  getRelatedEntries,
} from "../../lib/data/view-models/entry.ts";
import { buildListingJsonLd } from "../../lib/seo/structured-data/builders.ts";
import { entryUrl, homePath, categoryPath, areaPath } from "../../lib/routing/paths.ts";
import { computeCategoryStats } from "../../lib/aggregates/compute.ts";

export function getStaticPaths() {
  const dataset = loadDataset();
  return dataset.entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { slug: entry.slug },
  }));
}

const { slug } = Astro.props;
const dataset = loadDataset();
const entry = dataset.entries.find((e) => e.slug === slug);
if (!entry) throw new Error(`Entry not found: ${slug}`);

const vm = toEntryViewModel(
  entry,
  dataset.categories,
  dataset.areas,
  dataset.entries,
  dataset.indications,
  dataset.associations,
);
const primaryArea = vm.areas[0];
const jsonLd = buildListingJsonLd(
  entry,
  vm.category,
  vm.areas,
  vm.indications,
  dataset.associations.filter((item) => (entry.associationIds ?? []).includes(item.id)),
);
const relatedResult = getRelatedEntries(
  entry,
  dataset.entries,
  dataset.categories,
  dataset.areas,
  4,
  dataset.indications,
);
const related = relatedResult.entries.map((e) =>
  toEntryCardViewModel(e, dataset.categories, dataset.areas),
);
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const breadcrumbItems = [
  { label: "Startseite", href: homePath() },
  ...(vm.category
    ? [{ label: vm.category.name, href: categoryPath(vm.category.slug) }]
    : []),
  ...(primaryArea
    ? [{ label: primaryArea.name, href: areaPath(primaryArea.slug) }]
    : []),
  { label: entry.name },
];
---

<BaseLayout
  title={entry.name}
  description={entry.description}
  canonical={entryUrl(entry.slug)}
  image={siteConfig.features.images ? vm.primaryImage : undefined}
>
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <JsonLd slot="head" data={jsonLd} />

  <article data-testid="entry-page" class="profile">
    <div class="profile__top">
      <Breadcrumbs items={breadcrumbItems} />
      <EntryHeader vm={vm} />
    </div>

    <div class="profile__cols">
      <div class="profile__main">
        {siteConfig.features.images && <EntryImagesSection vm={vm} />}

        <section>
          <h2>Über</h2>
          <p data-testid="entry-description">{entry.description}</p>
          {vm.credentialsLine && (
            <p class="profile__credentials" data-testid="entry-credentials">{vm.credentialsLine}</p>
          )}
        </section>

        <OffersSection offers={vm.formattedOffers} isOpen={entry.isOpen} />
        {siteConfig.features.map && <EntryMapSection entry={entry} />}
        {(entry.faq ?? []).length > 0 && <FaqSection items={entry.faq!} variant="cards" />}
        <RelatedEntries cards={related} title={relatedResult.title} />
        <LastUpdated date={entry.lastUpdated} />
      </div>

      <EntrySidebar vm={vm} />
    </div>
  </article>
</BaseLayout>

<style>
  .profile { display: flex; flex-direction: column; gap: 2rem; }
  .profile__cols {
    display: grid;
    grid-template-columns: minmax(420px, 1fr) minmax(320px, 440px);
    gap: 2rem;
    align-items: start;
  }
  .profile__main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    min-width: 0;
  }
  .profile__credentials {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .profile__cols { grid-template-columns: minmax(0, 1fr); }
    .profile { padding-bottom: 5rem; }
  }
</style>
