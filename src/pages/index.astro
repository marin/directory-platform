---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/navigation/SiteHeader.astro";
import EntryCard from "../components/cards/EntryCard.astro";
import { loadDataset } from "../lib/data/load-dataset.ts";
import { computeCategoryStats, computeIndicationStats, computeAssociationStats } from "../lib/aggregates/compute.ts";
import {
  toEntryCardViewModel,
  shouldIndexIndication,
  shouldIndexAssociation,
} from "../lib/data/view-models/entry.ts";
import { indicationPath, indicationsPath, associationPath, associationsPath } from "../lib/routing/paths.ts";
import JsonLd from "../components/seo/JsonLd.astro";
import { buildOrganizationJsonLd } from "../lib/seo/structured-data/organization.ts";
import siteConfig from "../../config/site.config.ts";

const dataset = loadDataset();
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const featured = dataset.entries
  .filter((e) => e.isOpen)
  .slice(0, 6)
  .map((e) => toEntryCardViewModel(e, dataset.categories, dataset.areas));
const indicationsWithCounts = dataset.indications
  .map((indication) => ({
    ...indication,
    count: computeIndicationStats(dataset.entries, indication.id).listingCount,
  }))
  .filter((indication) => shouldIndexIndication(indication.count).index)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "de"));
const associationsWithCounts = dataset.associations
  .map((association) => ({
    ...association,
    count: computeAssociationStats(dataset.entries, association.id).listingCount,
  }))
  .filter((association) => shouldIndexAssociation(association.count).index)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "de"));
---

<BaseLayout title={siteConfig.site.name} description={siteConfig.site.description}>
  <JsonLd slot="head" data={buildOrganizationJsonLd()} />
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <h1>{siteConfig.site.name}</h1>
  <p class="muted">{siteConfig.site.description}</p>

  <h2>Nach Schwerpunkt</h2>
  <div class="grid grid-3">
    {categoriesWithCounts.map((cat) => (
      <a href={`/category/${cat.slug}`} class="card" style="text-decoration: none; color: inherit;">
        <strong>{cat.name}</strong>
        <p class="muted">{cat.count} {siteConfig.directory.entryPlural}</p>
      </a>
    ))}
  </div>

  {siteConfig.features.areas && (
    <>
      <h2>Nach Bezirk</h2>
      <div class="grid grid-2">
        {dataset.areas.map((area) => (
          <a href={`/area/${area.slug}`} class="card" style="text-decoration: none; color: inherit;">
            <strong>{area.name}</strong>
          </a>
        ))}
      </div>
    </>
  )}

  {indicationsWithCounts.length > 0 && (
    <>
        <h2><a href={indicationsPath()} data-testid="home-indications-heading">Nach Beschwerde</a></h2>
      <div class="grid grid-3">
        {indicationsWithCounts.map((indication) => (
          <a href={indicationPath(indication.slug)} class="card" style="text-decoration: none; color: inherit;" data-testid="home-indication">
            <strong>{indication.name}</strong>
            <p class="muted">{indication.count} {siteConfig.directory.entryPlural}</p>
          </a>
        ))}
      </div>
    </>
  )}

  {associationsWithCounts.length > 0 && (
    <>
      <h2><a href={associationsPath()} data-testid="home-associations-heading">Nach Verband</a></h2>
      <div class="grid grid-3">
        {associationsWithCounts.map((association) => (
          <a href={associationPath(association.slug)} class="card" style="text-decoration: none; color: inherit;" data-testid="home-association">
            <strong>{association.abbreviation ?? association.name}</strong>
            <p class="muted">{association.count} {siteConfig.directory.entryPlural}</p>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Ausgewählte {siteConfig.directory.entryPlural}</h2>
  <div class="grid grid-2">
    {featured.map((card) => <EntryCard card={card} />)}
  </div>
</BaseLayout>
