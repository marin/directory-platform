---
import LegalLayout from "../layouts/LegalLayout.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import siteConfig from "../../config/site.config.ts";

const origin = siteConfig.site.origin.replace(/\/$/, "");
const entryRoute = siteConfig.directory.entryRoute;
---

<LegalLayout
  title="Praxis eintragen"
  description={`Eintrag korrigieren, beanspruchen oder vorschlagen — ${siteConfig.site.name}.`}
>
  <p>
    Die Aufnahme ist kostenlos und unabhängig davon, ob eine Praxis mit uns zusammenarbeitet.
    Über dieses Formular können Sie uns Folgendes mitteilen:
  </p>
  <ul>
    <li><strong>Korrektur</strong> — falsche Adresse, Telefonnummer, Öffnungszeiten o. Ä.</li>
    <li><strong>Beanspruchen</strong> — Sie sind Inhaberin oder Inhaber des Eintrags und möchten Änderungen vornehmen</li>
    <li><strong>Neuer Eintrag</strong> — Ihre Praxis fehlt im Verzeichnis</li>
    <li><strong>Löschung</strong> — Sie möchten, dass Ihr Eintrag entfernt wird</li>
  </ul>
  <p id="claim-listing-note" hidden data-testid="claim-listing-note">
    Die Adresse des Profileintrags wird mit der Nachricht mitgeschickt.
  </p>
  <p>
    Bitte nennen Sie Praxisname und Adresse in Berlin und — wenn möglich — die URL des betroffenen
    Eintrags. Wir prüfen die Angaben und melden uns in der Regel innerhalb von 5 Werktagen.
  </p>

  <ContactForm subject="Eintrag korrigieren" />
</LegalLayout>

<script is:inline define:vars={{ origin, entryRoute }}>
  const slug = new URLSearchParams(window.location.search).get("eintrag");
  if (slug) {
    const listingUrl = `${origin}/${entryRoute}/${slug}/`;
    const listingInput = document.getElementById("listing-url");
    if (listingInput instanceof HTMLInputElement) listingInput.value = listingUrl;
    const subject = document.querySelector('select[name="subject"]');
    if (subject instanceof HTMLSelectElement) subject.value = "Eintrag beanspruchen";
    const note = document.getElementById("claim-listing-note");
    if (note) note.hidden = false;
  }
</script>
