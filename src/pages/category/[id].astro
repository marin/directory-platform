---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/navigation/SiteHeader.astro";
import EntryCard from "../../components/cards/EntryCard.astro";
import AggregateFacts from "../../components/collections/AggregateFacts.astro";
import FaqSection from "../../components/faq/FaqSection.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import { loadDataset } from "../../lib/data/load-dataset.ts";
import {
  toEntryCardViewModel,
  shouldIndexCategory,
} from "../../lib/data/view-models/entry.ts";
import { computeCategoryStats } from "../../lib/aggregates/compute.ts";
import { buildCollectionJsonLd, buildAggregateFactText } from "../../lib/seo/structured-data/builders.ts";
import { categoryPath, categoryUrl } from "../../lib/routing/paths.ts";
import { pageSlice, totalPages as computeTotalPages } from "../../lib/pagination.ts";
import PaginationNav from "../../components/navigation/PaginationNav.astro";
import siteConfig from "../../../config/site.config.ts";

export function getStaticPaths() {
  const dataset = loadDataset();
  return dataset.categories.map((cat) => {
    const count = computeCategoryStats(dataset.entries, cat.id).listingCount;
    const { index, noindex } = shouldIndexCategory(count);
    if (!index && !noindex) return [];
    return {
      params: { id: cat.slug },
      props: { categoryId: cat.id, noindex },
    };
  }).flat();
}

const { categoryId, noindex } = Astro.props;
const dataset = loadDataset();
const category = dataset.categories.find((c) => c.id === categoryId)!;
const openEntries = dataset.entries.filter(
  (e) => e.isOpen && e.categories.includes(categoryId),
);
const stats = computeCategoryStats(dataset.entries, categoryId);
const intro = dataset.categoryIntros.get(categoryId);
const faq = dataset.categoryFaqs.get(categoryId);
const cards = openEntries.map((e) =>
  toEntryCardViewModel(e, dataset.categories, dataset.areas),
);
const jsonLd = buildCollectionJsonLd("category", category, openEntries, stats, faq?.faq);
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const factText = buildAggregateFactText(stats, category.name);
const pageSize = siteConfig.pagination.categoryPageSize;
const currentPage = 1;
const lastPage = computeTotalPages(openEntries.length, pageSize);
const pageEntries = pageSlice(cards, currentPage, pageSize);
---

<BaseLayout
  title={category.name}
  description={intro?.intro ?? category.description}
  canonical={categoryUrl(category.slug)}
  noindex={noindex}
>
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <JsonLd slot="head" data={jsonLd} />
  <h1>{category.name}</h1>
  {intro && <p style="margin: 1rem 0;">{intro.intro}</p>}
  <AggregateFacts text={factText} />
  <div class="grid grid-2">
    {pageEntries.map((card) => <EntryCard card={card} />)}
  </div>
  <PaginationNav
    currentPage={currentPage}
    totalPages={lastPage}
    basePath={categoryPath(category.slug)}
  />
  {faq && <FaqSection items={faq.faq} />}
</BaseLayout>
