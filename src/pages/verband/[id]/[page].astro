---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/navigation/SiteHeader.astro";
import Breadcrumbs from "../../../components/navigation/Breadcrumbs.astro";
import HeroBand from "../../../components/layout/HeroBand.astro";
import FilterBar from "../../../components/navigation/FilterBar.astro";
import EntryCard from "../../../components/cards/EntryCard.astro";
import FaqSection from "../../../components/faq/FaqSection.astro";
import LastUpdated from "../../../components/entry/LastUpdated.astro";
import JsonLd from "../../../components/seo/JsonLd.astro";
import PaginationNav from "../../../components/navigation/PaginationNav.astro";
import { loadDataset } from "../../../lib/data/load-dataset.ts";
import { sortEntriesByRichness } from "../../../lib/data/entry-richness.ts";
import {
  toEntryCardViewModel,
  shouldIndexAssociation,
} from "../../../lib/data/view-models/entry.ts";
import { computeCategoryStats, computeAssociationStats, associationEntries } from "../../../lib/aggregates/compute.ts";
import { associationHubTitle, associationShortName } from "../../../lib/data/association-hubs.ts";
import { buildCollectionJsonLd } from "../../../lib/seo/structured-data/builders.ts";
import { homePath, associationPath, associationsPath, associationUrl, areaPath, areasPath } from "../../../lib/routing/paths.ts";
import { pageSlice, totalPages as computeTotalPages } from "../../../lib/pagination.ts";
import siteConfig from "../../../../config/site.config.ts";

export function getStaticPaths() {
  const dataset = loadDataset();
  const pageSize = siteConfig.pagination.associationPageSize;
  const paths = [];

  for (const association of dataset.associations) {
    const count = computeAssociationStats(dataset.entries, association.id).listingCount;
    const { index, noindex } = shouldIndexAssociation(count);
    if (!index && !noindex) continue;

    const lastPage = computeTotalPages(count, pageSize);
    for (let page = 2; page <= lastPage; page += 1) {
      paths.push({
        params: { id: association.slug, page: String(page) },
        props: { associationId: association.id, page, lastPage, noindex },
      });
    }
  }

  return paths;
}

const { associationId, page, lastPage, noindex } = Astro.props;
const dataset = loadDataset();
const association = dataset.associations.find((item) => item.id === associationId)!;
const openEntries = sortEntriesByRichness(associationEntries(dataset.entries, associationId));
const stats = computeAssociationStats(dataset.entries, associationId);
const intro = dataset.associationIntros.get(associationId);
const faq = dataset.associationFaqs.get(associationId);
const cards = openEntries.map((e) =>
  toEntryCardViewModel(e, dataset.categories, dataset.areas),
);
const jsonLd = buildCollectionJsonLd("association", association, openEntries, stats, faq?.faq, page);
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const pageSize = siteConfig.pagination.associationPageSize;
const pageEntries = pageSlice(cards, page, pageSize);
const title = `${associationHubTitle(association)} – Seite ${page}`;
const shortName = associationShortName(association);
const areaItems = dataset.areas.map((area) => ({ name: area.name, href: areaPath(area.slug) }));
---

<BaseLayout
  title={title}
  description={intro?.intro ?? association.description}
  canonical={associationUrl(association.slug, page)}
  noindex={noindex}
>
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <JsonLd slot="head" data={jsonLd} />

  <article data-testid="association-page" class="hubpage">
    <Breadcrumbs
      items={[
        { label: "Startseite", href: homePath() },
        { label: "Verbände", href: associationsPath() },
        { label: shortName },
      ]}
    />

    <HeroBand
      eyebrow={`Verband · Seite ${page}`}
      title={associationHubTitle(association)}
      lead={intro?.intro ?? association.description}
      seed={association.slug}
    />

    <FilterBar
      label="Bezirk wählen"
      items={areaItems}
      indexHref={areasPath()}
      dialogId={`filter-${association.slug}-${page}`}
    />

    <div class="grid grid-3">
      {pageEntries.map((card) => <EntryCard card={card} />)}
    </div>

    <PaginationNav currentPage={page} totalPages={lastPage} basePath={associationPath(association.slug)} />
    {faq && <FaqSection items={faq.faq} variant="band" />}
    {stats.mostRecentUpdate && <LastUpdated date={stats.mostRecentUpdate} />}
  </article>
</BaseLayout>

<style>
  .hubpage { display: flex; flex-direction: column; gap: 2.5rem; }
</style>
