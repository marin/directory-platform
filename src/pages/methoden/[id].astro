---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/navigation/SiteHeader.astro";
import HeroBand from "../../components/layout/HeroBand.astro";
import FilterBar from "../../components/navigation/FilterBar.astro";
import EntryCard from "../../components/cards/EntryCard.astro";
import EmptyState from "../../components/layout/EmptyState.astro";
import FaqSection from "../../components/faq/FaqSection.astro";
import LastUpdated from "../../components/entry/LastUpdated.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import { loadDataset } from "../../lib/data/load-dataset.ts";
import { sortEntriesByRichness } from "../../lib/data/entry-richness.ts";
import {
  toEntryCardViewModel,
  shouldIndexCategory,
} from "../../lib/data/view-models/entry.ts";
import { computeCategoryStats } from "../../lib/aggregates/compute.ts";
import { buildCollectionJsonLd } from "../../lib/seo/structured-data/builders.ts";
import { categoryPath, categoryUrl, areaPath, areasPath, methodsPath } from "../../lib/routing/paths.ts";
import { pageSlice, totalPages as computeTotalPages } from "../../lib/pagination.ts";
import PaginationNav from "../../components/navigation/PaginationNav.astro";
import siteConfig from "../../../config/site.config.ts";

export function getStaticPaths() {
  const dataset = loadDataset();
  return dataset.categories.map((cat) => {
    const count = computeCategoryStats(dataset.entries, cat.id).listingCount;
    const { index, noindex } = shouldIndexCategory(count);
    if (!index && !noindex) return [];
    return {
      params: { id: cat.slug },
      props: { categoryId: cat.id, noindex },
    };
  }).flat();
}

const { categoryId, noindex } = Astro.props;
const dataset = loadDataset();
const category = dataset.categories.find((c) => c.id === categoryId)!;
const openEntries = sortEntriesByRichness(
  dataset.entries.filter((e) => e.isOpen && e.categories.includes(categoryId)),
);
const stats = computeCategoryStats(dataset.entries, categoryId);
const intro = dataset.categoryIntros.get(categoryId);
const faq = dataset.categoryFaqs.get(categoryId);
const cards = openEntries.map((e) =>
  toEntryCardViewModel(e, dataset.categories, dataset.areas),
);
const jsonLd = buildCollectionJsonLd("category", category, openEntries, stats, faq?.faq);
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const pageSize = siteConfig.pagination.categoryPageSize;
const currentPage = 1;
const lastPage = computeTotalPages(openEntries.length, pageSize);
const pageEntries = pageSlice(cards, currentPage, pageSize);

/* Filterleiste zeigt die jeweils andere Dimension: Bezirke. Keine Zähler (B2). */
const areaItems = dataset.areas.map((area) => ({
  name: area.name,
  href: areaPath(area.slug),
}));
---

<BaseLayout
  title={category.name}
  description={intro?.intro ?? category.description}
  canonical={categoryUrl(category.slug)}
  noindex={noindex}
>
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <JsonLd slot="head" data={jsonLd} />

  <HeroBand
    eyebrow="Schwerpunkt"
    title={category.name}
    lead={intro?.intro ?? category.description}
    seed={category.slug}
  />

  <FilterBar
    label="Bezirk wählen"
    items={areaItems}
    indexHref={areasPath()}
    dialogId={`filter-${category.slug}`}
  />

  {pageEntries.length > 0 ? (
    <div class="grid grid-3">
      {pageEntries.map((card) => <EntryCard card={card} />)}
    </div>
  ) : (
    <EmptyState
      headline={`Für ${category.name} liegt uns kein Eintrag vor.`}
      note="Das heißt nicht, dass es keine Praxis gibt — nur, dass wir keine erfasst haben. Kennen Sie eine?"
      actions={[
        { label: "Praxis eintragen", href: "/eintrag-melden/", kind: "primary" },
        { label: "Alle Methoden", href: methodsPath() },
      ]}
    />
  )}

  <PaginationNav
    currentPage={currentPage}
    totalPages={lastPage}
    basePath={categoryPath(category.slug)}
  />
  {faq && <FaqSection items={faq.faq} variant="band" />}
  {stats.mostRecentUpdate && <LastUpdated date={stats.mostRecentUpdate} />}
</BaseLayout>
