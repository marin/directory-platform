---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/navigation/SiteHeader.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import HeroBand from "../../components/layout/HeroBand.astro";
import HubTile from "../../components/cards/HubTile.astro";
import FaqSection from "../../components/faq/FaqSection.astro";
import LastUpdated from "../../components/entry/LastUpdated.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import { loadDataset } from "../../lib/data/load-dataset.ts";
import { computeCategoryStats, computeIndicationStats } from "../../lib/aggregates/compute.ts";
import { buildIndicationsIndexCopy } from "../../lib/data/indication-hubs.ts";
import { buildIndicationsIndexJsonLd } from "../../lib/seo/structured-data/builders.ts";
import { homePath, indicationPath, indicationsUrl } from "../../lib/routing/paths.ts";

const dataset = loadDataset();
const copy = buildIndicationsIndexCopy(dataset.entries, dataset.indications);
const jsonLd = buildIndicationsIndexJsonLd(
  copy.hubs,
  copy.title,
  copy.description,
  copy.faq,
);
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const mostRecentUpdate = copy.hubs
  .map((hub) => computeIndicationStats(dataset.entries, hub.id).mostRecentUpdate)
  .filter((date): date is string => Boolean(date))
  .sort()
  .at(-1);
---

<BaseLayout title={copy.title} description={copy.description} canonical={indicationsUrl()}>
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <JsonLd slot="head" data={jsonLd} />

  <article data-testid="indications-index" class="hubindex">
    <Breadcrumbs items={[{ label: "Startseite", href: homePath() }, { label: "Beschwerden" }]} />

    <HeroBand eyebrow="Übersicht" title={copy.title} lead={copy.intro} seed="beschwerden" />
    <p hidden data-testid="indications-index-intro">{copy.intro}</p>

    <div class="grid grid-4">
      {copy.hubs.map((hub) => (
        <div data-testid="indications-index-hub">
          <HubTile
            name={hub.name}
            count={hub.count}
            href={indicationPath(hub.slug)}
            slug={hub.slug}
          />
        </div>
      ))}
    </div>

    <FaqSection items={copy.faq} variant="band" />
    {mostRecentUpdate && <LastUpdated date={mostRecentUpdate} />}
  </article>
</BaseLayout>

<style>
  .hubindex { display: flex; flex-direction: column; gap: 2.5rem; }
  .hubindex .grid > div { display: flex; }
  .hubindex .grid > div > :global(*) { flex: 1; }
</style>
