---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/navigation/SiteHeader.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import HeroBand from "../../components/layout/HeroBand.astro";
import FilterBar from "../../components/navigation/FilterBar.astro";
import EntryCard from "../../components/cards/EntryCard.astro";
import EmptyState from "../../components/layout/EmptyState.astro";
import FaqSection from "../../components/faq/FaqSection.astro";
import LastUpdated from "../../components/entry/LastUpdated.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import PaginationNav from "../../components/navigation/PaginationNav.astro";
import { loadDataset } from "../../lib/data/load-dataset.ts";
import { sortEntriesByRichness } from "../../lib/data/entry-richness.ts";
import {
  toEntryCardViewModel,
  shouldIndexIndication,
} from "../../lib/data/view-models/entry.ts";
import { computeCategoryStats, computeIndicationStats, indicationEntries } from "../../lib/aggregates/compute.ts";
import { relatedIndications, indicationHubTitle } from "../../lib/data/indication-hubs.ts";
import { buildCollectionJsonLd } from "../../lib/seo/structured-data/builders.ts";
import { homePath, indicationPath, indicationsPath, indicationUrl, areaPath } from "../../lib/routing/paths.ts";
import { pageSlice, totalPages as computeTotalPages } from "../../lib/pagination.ts";
import siteConfig from "../../../config/site.config.ts";

export function getStaticPaths() {
  const dataset = loadDataset();
  return dataset.indications.flatMap((indication) => {
    const count = computeIndicationStats(dataset.entries, indication.id).listingCount;
    const { index, noindex } = shouldIndexIndication(count);
    if (!index && !noindex) return [];
    return {
      params: { id: indication.slug },
      props: { indicationId: indication.id, noindex },
    };
  });
}

const { indicationId, noindex } = Astro.props;
const dataset = loadDataset();
const indication = dataset.indications.find((item) => item.id === indicationId)!;
const openEntries = sortEntriesByRichness(indicationEntries(dataset.entries, indicationId));
const stats = computeIndicationStats(dataset.entries, indicationId);
const intro = dataset.indicationIntros.get(indicationId);
const faq = dataset.indicationFaqs.get(indicationId);
const cards = openEntries.map((e) =>
  toEntryCardViewModel(e, dataset.categories, dataset.areas),
);
const jsonLd = buildCollectionJsonLd("indication", indication, openEntries, stats, faq?.faq);
const related = relatedIndications(dataset.entries, indicationId, dataset.indications).filter(
  (item) => shouldIndexIndication(item.count).index,
);
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const pageSize = siteConfig.pagination.indicationPageSize;
const currentPage = 1;
const lastPage = computeTotalPages(openEntries.length, pageSize);
const pageEntries = pageSlice(cards, currentPage, pageSize);
const title = indicationHubTitle(indication.name);

const areaItems = dataset.areas.map((area) => ({
  name: area.name,
  href: areaPath(area.slug),
}));
---

<BaseLayout
  title={title}
  description={intro?.intro ?? indication.description}
  canonical={indicationUrl(indication.slug)}
  noindex={noindex}
>
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <JsonLd slot="head" data={jsonLd} />

  <article data-testid="indication-page" class="hubpage">
    <Breadcrumbs
      items={[
        { label: "Startseite", href: homePath() },
        { label: "Beschwerden", href: indicationsPath() },
        { label: indication.name },
      ]}
    />

    <HeroBand
      eyebrow="Beschwerde"
      title={title}
      lead={intro?.intro ?? indication.description}
      seed={indication.slug}
    />
    {intro && <p hidden data-testid="indication-intro">{intro.intro}</p>}

    <FilterBar
      label="Bezirk wählen"
      items={areaItems}
      indexHref="/area"
      dialogId={`filter-${indication.slug}`}
    />

    {pageEntries.length > 0 ? (
      <div class="grid grid-3">
        {pageEntries.map((card) => <EntryCard card={card} />)}
      </div>
    ) : (
      <EmptyState
        headline={`Für ${indication.name} liegt uns kein Eintrag vor.`}
        note="Das heißt nicht, dass es keine Praxis gibt — nur, dass wir keine erfasst haben. Kennen Sie eine?"
        actions={[
          { label: "Praxis eintragen", href: "/eintrag-melden", kind: "primary" },
          { label: "Alle Beschwerden", href: indicationsPath() },
        ]}
      />
    )}

    <PaginationNav
      currentPage={currentPage}
      totalPages={lastPage}
      basePath={indicationPath(indication.slug)}
    />

    {related.length > 0 && (
      <section>
        <h2>Weitere Beschwerden</h2>
        <div class="chiprow">
          {related.map((item) => (
            <a href={indicationPath(item.slug)} class="chip" data-testid="related-indication">
              {item.name}
            </a>
          ))}
        </div>
      </section>
    )}

    {faq && <FaqSection items={faq.faq} variant="band" />}
    {stats.mostRecentUpdate && <LastUpdated date={stats.mostRecentUpdate} />}
  </article>
</BaseLayout>

<style>
  .hubpage { display: flex; flex-direction: column; gap: 2.5rem; }
  .chiprow { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
