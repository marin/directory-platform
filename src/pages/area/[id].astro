---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/navigation/SiteHeader.astro";
import HeroBand from "../../components/layout/HeroBand.astro";
import FilterBar from "../../components/navigation/FilterBar.astro";
import EntryCard from "../../components/cards/EntryCard.astro";
import EmptyState from "../../components/layout/EmptyState.astro";
import FaqSection from "../../components/faq/FaqSection.astro";
import LastUpdated from "../../components/entry/LastUpdated.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import { loadDataset } from "../../lib/data/load-dataset.ts";
import { sortEntriesByRichness } from "../../lib/data/entry-richness.ts";
import {
  toEntryCardViewModel,
  shouldIndexArea,
} from "../../lib/data/view-models/entry.ts";
import { computeAreaStats, computeCategoryStats } from "../../lib/aggregates/compute.ts";
import { buildCollectionJsonLd } from "../../lib/seo/structured-data/builders.ts";
import { areaPath, areaUrl, categoryPath } from "../../lib/routing/paths.ts";
import { pageSlice, totalPages as computeTotalPages } from "../../lib/pagination.ts";
import PaginationNav from "../../components/navigation/PaginationNav.astro";
import siteConfig from "../../../config/site.config.ts";

export function getStaticPaths() {
  const dataset = loadDataset();
  return dataset.areas.map((area) => {
    const count = computeAreaStats(dataset.entries, area.id).listingCount;
    const { index, noindex } = shouldIndexArea(count);
    if (!index && !noindex) return [];
    return {
      params: { id: area.slug },
      props: { areaId: area.id, noindex },
    };
  }).flat();
}

const { areaId, noindex } = Astro.props;
const dataset = loadDataset();
const area = dataset.areas.find((a) => a.id === areaId)!;
const openEntries = sortEntriesByRichness(
  dataset.entries.filter((e) => e.isOpen && (e.areaIds ?? []).includes(areaId)),
);
const stats = computeAreaStats(dataset.entries, areaId);
const intro = dataset.areaIntros.get(areaId);
const faq = dataset.areaFaqs.get(areaId);
const cards = openEntries.map((e) =>
  toEntryCardViewModel(e, dataset.categories, dataset.areas),
);
const jsonLd = buildCollectionJsonLd("area", area, openEntries, stats, faq?.faq);
const categoriesWithCounts = dataset.categories.map((cat) => ({
  ...cat,
  count: computeCategoryStats(dataset.entries, cat.id).listingCount,
}));
const pageSize = siteConfig.pagination.areaPageSize;
const currentPage = 1;
const lastPage = computeTotalPages(openEntries.length, pageSize);
const pageEntries = pageSlice(cards, currentPage, pageSize);

/* Filterleiste zeigt die jeweils andere Dimension: Schwerpunkte. Keine Zähler (B2). */
const categoryItems = dataset.categories.map((cat) => ({
  name: cat.name,
  href: categoryPath(cat.slug),
}));
---

<BaseLayout
  title={area.name}
  description={intro?.intro ?? area.description}
  canonical={areaUrl(area.slug)}
  noindex={noindex}
>
  <SiteHeader slot="header" categories={categoriesWithCounts} />
  <JsonLd slot="head" data={jsonLd} />

  <HeroBand
    eyebrow="Bezirk"
    title={area.name}
    lead={intro?.intro ?? area.description}
    seed={area.slug}
  />

  <FilterBar
    label="Schwerpunkt wählen"
    items={categoryItems}
    indexHref="/methoden"
    dialogId={`filter-${area.slug}`}
  />

  {pageEntries.length > 0 ? (
    <div class="grid grid-3">
      {pageEntries.map((card) => <EntryCard card={card} />)}
    </div>
  ) : (
    <EmptyState
      headline={`In ${area.name} ist bisher keine Praxis erfasst.`}
      note="Das heißt nicht, dass es keine gibt — nur, dass wir keine erfasst haben. Kennen Sie eine?"
      actions={[
        { label: "Praxis eintragen", href: "/eintrag-melden", kind: "primary" },
        { label: "Alle Bezirke", href: "/area" },
      ]}
    />
  )}

  <PaginationNav
    currentPage={currentPage}
    totalPages={lastPage}
    basePath={areaPath(area.slug)}
  />
  {faq && <FaqSection items={faq.faq} variant="band" />}
  {stats.mostRecentUpdate && <LastUpdated date={stats.mostRecentUpdate} />}
</BaseLayout>
